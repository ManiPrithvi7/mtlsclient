# Copy to .env. Also loads ../../statsmqtt/.env when present (MQTT_* fallbacks).

# --- MQTT ---
MQTT_BROKER=broker.withproof.io
MQTT_PORT=8883
MQTT_TLS_VERIFY_HOST=broker.withproof.io
# MQTT_URL=mqtts://broker.withproof.io:8883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_PEER_CN_AS_MQTT_USERNAME=0
# MQTT_BROKER_CA=

# --- Device ---
DEVICE_ID=DEVICE-19
CERT_CN_PREFIX=PROOF
# APP_VERSION=1.0.0

# --- Backend API ---
BACKEND_URL=https://server.withproof.io
PROVISIONING_SERVER_URL=https://server.withproof.io
# OTA_API_BASE=https://server.withproof.io

# --- Provisioning (first run; cert missing in src/certs/) ---
# AUTO_PROVISION=1
# PROVISIONING_TOKEN=<one-time JWT from dashboard onboarding>
# PROVISIONING_TOKEN_IN_BODY=0

# --- Recovery (auto reissue when cert missing / expired) ---
# RECOVERY_MODE=1
# RECOVERY_TOKEN=<one-time token from dashboard>
# RECOVERY_CODE=<alias for RECOVERY_TOKEN>

